{
  "name": "ai-ecosystem",
  "private": true,
  "workspaces": [
    "products/*/apps/web"
  ],
  "scripts": {
    "web:dev": "npm run dev --workspace @ai-ecosystem/knowledge-web",
    "web:lint": "npm run lint --workspace @ai-ecosystem/knowledge-web",
    "web:typecheck": "npm run typecheck --workspace @ai-ecosystem/knowledge-web",
    "web:test": "npm run test --workspace @ai-ecosystem/knowledge-web",
    "web:build": "npm run build --workspace @ai-ecosystem/knowledge-web",
    "web:contracts": "npm run contracts --workspace @ai-ecosystem/knowledge-web",
    "web:contracts:check": "npm run contracts:check --workspace @ai-ecosystem/knowledge-web",
    "agent:web:dev": "npm run dev --workspace @ai-ecosystem/agent-web",
    "agent:web:lint": "npm run lint --workspace @ai-ecosystem/agent-web",
    "agent:web:typecheck": "npm run typecheck --workspace @ai-ecosystem/agent-web",
    "agent:web:test": "npm run test --workspace @ai-ecosystem/agent-web",
    "agent:web:build": "npm run build --workspace @ai-ecosystem/agent-web",
    "agent:web:contracts": "npm run contracts --workspace @ai-ecosystem/agent-web",
    "agent:web:contracts:check": "npm run contracts:check --workspace @ai-ecosystem/agent-web"
  },
  "allowScripts": {
    "@tailwindcss/oxide@4.1.13": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
